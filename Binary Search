#include <iostream>
#include <vector>
using namespace std;
int BinarySearch( vector<int>arr,int target){
    int st=0,en=arr.size()-1;
   
    while(st<=en){
        
         int mid=st+(en-st)/2;
         
        if(target<arr[mid]){
            en=mid-1;
        }else if(target>arr[mid]){
            st=mid+1;
        }else{
            return mid;// ans
        }
    }return -1;
}
int main()
{
    vector<int>arr={2,3,4,5,6,7,8};
    
    int target;
    cout<<"enter the target value:";
    cin>>target;
    cout<<BinarySearch(arr,target)<<endl;
    return 0;
}
